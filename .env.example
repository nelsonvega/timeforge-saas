# Database Configuration
# Option 1: Single DATABASE_URL (recommended)
# For local PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/database
# For network PostgreSQL:
# DATABASE_URL=postgresql://user:password@192.168.1.100:5432/database
# For SSL-enabled network database:
# DATABASE_URL=postgresql://user:password@hostname:5432/database?sslmode=require
# For Neon serverless:
# DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Option 2: Individual parameters (optional - DATABASE_URL takes precedence)
PGHOST=your-database-host
PGUSER=your-database-user
PGPASSWORD=your-database-password
PGDATABASE=your-database-name
PGPORT=5432

# SSL Configuration (optional - for network databases)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false  # Set to false for self-signed certificates

# Authentication Configuration
SESSION_SECRET=your-session-secret-key-here

# Google OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Server Configuration
PORT=5000
NODE_ENV=development
